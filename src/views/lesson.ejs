<p><a href="/courses/<%= course.slug %>">← <%= title(course, lang) %></a></p>
<h1><%= title(lesson, lang) %></h1>
<% if (lesson.kind === 'text') { %><div class="prose"><%- html %></div><% } %>
<% if (embed) { %><div class="video"><iframe src="<%= embed %>" allowfullscreen loading="lazy"></iframe></div><% } %>
<% if (pdf) { %><p><a href="<%= pdf %>" target="_blank" rel="noopener">PDF</a></p><% } %>
<% if (!done) { %>
  <form method="post" action="/courses/<%= course.slug %>/lessons/<%= lesson.position %>/complete"><button><%= t('complete') %></button></form>
<% } else { %><p>✓ <%= t('done') %></p><% } %>
<% if (next) { %><p><a href="/courses/<%= course.slug %>/lessons/<%= next.position %>"><%= t('next') %> →</a></p><% } %>
