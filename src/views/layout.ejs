<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title><%= t('site') %> · Mandala Riset</title>
<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/app.css">
</head>
<body>
<header class="top">
  <div class="bar">
    <a class="brand" href="/" aria-label="<%= t('site') %>">
      <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="15" fill="#0f766e"/><path d="M16 6v20M16 14c-4 0-6-2-7-5M16 18c4 0 6-2 7-5M16 22c-3 0-5-1.5-6-4M16 22c3 0 5-1.5 6-4" stroke="#fff" stroke-width="1.8" stroke-linecap="round" fill="none"/></svg>
      <span>Mandala <b>Riset</b> <small><%= lang === 'id' ? 'Akademi' : 'Academy' %></small></span>
    </a>
    <nav>
      <% if (wide) { %><a href="#kursus"><%= t('courses') %></a><% } %>
      <a href="<%= siteUrl %>"><%= lang === 'id' ? 'Situs utama' : 'Main site' %></a>
      <a href="?lang=<%= lang === 'id' ? 'en' : 'id' %>" class="pill"><%= lang === 'id' ? 'English' : 'Bahasa Indonesia' %></a>
      <% if (user) { %>
        <% if (user.role === 'admin') { %><a href="/admin">Admin</a><% } %>
        <a href="/account/password"><%= t('changePassword') %></a>
        <span class="who"><%= user.name %></span>
        <form method="post" action="/logout" class="inline"><button class="link"><%- t('logout') %></button></form>
      <% } else { %>
        <a href="/login"><%= t('login') %></a>
        <% if (selfSignup) { %><a href="/register" class="btn btn-sm"><%= t('register') %></a><% } else { %><a href="<%= contactUrl %>" class="btn btn-sm"><%= t('contactAdmin') %></a><% } %>
      <% } %>
    </nav>
  </div>
</header>
<main class="<%= wide ? 'full' : '' %>"><%- body %></main>
<footer class="foot">
  <div class="foot-in">
    <div><strong>PT Mandala Riset Indonesia</strong><br><span class="muted"><%= lang === 'id' ? 'Konsultan riset ekologi, karbon, dan biodiversitas.' : 'Research consultancy for ecology, carbon and biodiversity.' %></span></div>
    <div><a href="mailto:<%= contactEmail %>"><%= contactEmail %></a><br><a href="<%= siteUrl %>"><%= t('aboutSite') %></a></div>
    <div class="muted">© <%= new Date().getFullYear() %> PT Mandala Riset Indonesia. <%= t('rights') %></div>
  </div>
</footer>
</body></html>
