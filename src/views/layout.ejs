<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title><%= t('site') %></title>
<link rel="stylesheet" href="/static/app.css">
</head>
<body>
<header class="top"><a class="brand" href="/"><%= t('site') %></a>
<nav>
  <a href="?lang=<%= lang === 'id' ? 'en' : 'id' %>"><%= lang === 'id' ? 'EN' : 'ID' %></a>
  <% if (user) { %>
    <span><%= user.name %></span>
    <form method="post" action="/logout" class="inline"><button class="link"><%- t('logout') %></button></form>
  <% } else { %>
    <a href="/login"><%= t('login') %></a> <a href="/register"><%= t('register') %></a>
  <% } %>
</nav></header>
<main><%- body %></main>
</body></html>
