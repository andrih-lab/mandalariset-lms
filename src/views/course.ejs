<h1><%= title(course, lang) %></h1>
<p><%= L(course, 'desc', lang) %></p>
<% if (!user) { %>
  <p><a href="/login"><%= t('login') %></a></p>
<% } else if (!enrolled) { %>
  <form method="post" action="/courses/<%= course.slug %>/enroll"><button><%= t('enroll') %></button></form>
<% } else { %>
  <% if (certCode) { %><p class="cert-link">🎓
    <%= lang === 'id' ? 'Sertifikat:' : 'Certificate:' %>
    <a href="/certificate/<%= certCode %>/pdf?lang=id">PDF Bahasa Indonesia</a> ·
    <a href="/certificate/<%= certCode %>/pdf?lang=en">PDF English</a> ·
    <a href="/certificate/<%= certCode %>"><%= lang === 'id' ? 'Halaman verifikasi' : 'Verification page' %></a></p><% } %>
  <p><%= t('progress') %>: <%= lessons.filter(l => done.has(l.id)).length %>/<%= lessons.length %></p>
<% } %>
<ol class="lessons">
<% lessons.forEach(l => { %>
  <li><% if (l.section) { %><small><%= l.section %></small><br><% } %>
  <% if (enrolled) { %><a href="/courses/<%= course.slug %>/lessons/<%= l.position %>"><%= title(l, lang) %></a><% } else { %><%= title(l, lang) %><% } %>
  <% if (done.has(l.id)) { %> ✓<% } %></li>
<% }) %>
</ol>
